<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>autohack-core-tests</AssemblyName>
    <RootNamespace>AutoHack.CoreTests</RootNamespace>
  </PropertyGroup>

  <!-- 核心层直接以源码链接进来：插件编 net472，这里编 net10 —— 同一份 .cs，
       两处编译，零 NuGet、零项目引用。核心若误引 Hacknet/Pathfinder，这里立刻编不过。 -->
  <ItemGroup>
    <Compile Include="../../src/AutoHack/Core/**/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
